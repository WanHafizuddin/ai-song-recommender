# Supabase Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/postgres
# Google AI Studio (Gemini) API key — free tier
GEMINI_API_KEY=your_key_here
# Chat model id (override to swap models). Use `gemini-flash-latest` to always
# track Google's current Flash and avoid model-retirement 404s.
GEMINI_CHAT_MODEL=gemini-3.7-flash
# Set to "false" to disable the LLM rerank pass (demo the retrieve-only path)
RERANK_ENABLED=true
# Server port
PORT=3000
